{
  "name": "evehealthcare-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev": "npm run dev -w backend & npm run dev -w frontend",
    "verify:backend": "npm run verify -w backend",
    "verify:frontend": "npm run verify -w frontend",
    "verify": "npm run verify:backend && npm run verify:frontend",
    "install:all": "npm install"
  }
}
