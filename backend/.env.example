# Database connection string (e.g. from Supabase)
# Append ?pgbouncer=true&connection_limit=1 if using connection pooling with Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/evehealthcare"

# Authentication
JWT_SECRET="generate_a_random_secure_string_here"
JWT_EXPIRES_IN="1d"

# Webhooks (for payment signatures)
WEBHOOK_SECRET="generate_a_random_secure_string_here"

# Server configuration
PORT="3000"
NODE_ENV="development"
